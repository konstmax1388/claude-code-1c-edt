// ui_Драйвер: драйвер менеджера тестирования. Выполняет на клиенте BSL-скрипт из файла
// и пишет результат в файл. Запуск: 1cv8c ENTERPRISE ... /TESTMANAGER /Execute ui_Драйвер.epf /C "ui=<скрипт.bsl>|<выход.txt>"
// В скрипте доступны: Вывести(Текст), Дамп(Объект, Глубина).

&НаКлиенте
Перем ФайлВхода, ФайлВыхода, Результат;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Параметр = ПараметрЗапуска;
	Если СтрНачинаетсяС(Параметр, "ui=") Тогда
		Части = СтрРазделить(Сред(Параметр, 4), "|");
		Если Части.Количество() = 2 Тогда
			ФайлВхода  = Части[0];
			ФайлВыхода = Части[1];
		КонецЕсли;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ВыполнитьИЗавершить", 0.3, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИЗавершить()
	Результат = "";
	Попытка
		Чтение = Новый ЧтениеТекста(ФайлВхода, КодировкаТекста.UTF8);
		ТекстСкрипта = Чтение.Прочитать();
		Чтение.Закрыть();
		Выполнить(ТекстСкрипта);
	Исключение
		Вывести("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Запись = Новый ЗаписьТекста(ФайлВыхода, КодировкаТекста.UTF8);
	Запись.Записать(Результат);
	Запись.Закрыть();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Вывести(Текст)
	Результат = Результат + Текст + Символы.ПС;
КонецПроцедуры

&НаКлиенте
Процедура Дамп(Объект, Глубина = 5, Отступ = "")
	Имя = "";
	ТекстЗаг = "";
	Попытка
		Имя = Объект.Имя;
	Исключение
	КонецПопытки;
	Попытка
		ТекстЗаг = Объект.ТекстЗаголовка;
	Исключение
	КонецПопытки;
	Вывести(Отступ + Строка(ТипЗнч(Объект)) + " | " + Имя + " | " + ТекстЗаг);
	Если Глубина <= 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Подчиненные = Объект.ПолучитьПодчиненныеОбъекты();
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого Подчиненный Из Подчиненные Цикл
		Дамп(Подчиненный, Глубина - 1, Отступ + "  ");
	КонецЦикла;
КонецПроцедуры
