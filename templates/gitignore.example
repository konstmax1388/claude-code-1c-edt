# Пример .gitignore для EDT-проекта на типовой конфигурации.
# Переименовать в .gitignore и положить в корень репозитория.
# Идея: типовая (гигабайты) в git не идет, версионируются только свои объекты по префиксам.
# Замените ИмяПроекта и префиксы на свои.

# секреты и локальные настройки
.v8-project.json
.claude/settings.local.json

# служебное EDT
.metadata/
bin/
.settings/
*.log
*.bak
__pycache__/

# основная конфигурация: исключаем все...
/ИмяПроекта/src/**
# ...оставляем проходимыми каталоги видов объектов (Documents/, Catalogs/, ...)
!/ИмяПроекта/src/*/

# ...и возвращаем свои объекты по префиксам
!/ИмяПроекта/src/*/ПРЕФ_*/
!/ИмяПроекта/src/*/ПРЕФ_*/**

# Configuration.mdo обязателен: это реестр состава.
# Без него откат по git вернет папки объектов, но не их регистрацию в конфигурации.
!/ИмяПроекта/src/Configuration/Configuration.mdo

# Типовые файлы, которые вы правите (порядок разделов, состав плана обмена РИБ),
# тоже стоит вернуть точечно: обновление типовой их затирает.
!/ИмяПроекта/src/Configuration/CommandInterface.cmi
